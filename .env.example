# Copy to .env and replace every example secret, or use .dev/scripts/docker.ps1 -Action init.
# This template contains no valid credentials. Never commit .env.
COMPOSE_PROJECT_NAME=bervel
POSTGRES_PASSWORD=replace-with-generated-admin-password
BERVEL_DB_PASSWORD=replace-with-generated-app-password
BERVEL_TEST_DB_PASSWORD=replace-with-generated-test-password
BERVEL_E2E_ACCESS_KEY=replace-with-generated-browser-test-key
BERVEL_INSPECTION_DB_PASSWORD=replace-with-generated-read-only-password
BERVEL_INSPECTION_TOKEN=replace-with-generated-private-reader-token
BERVEL_ACCESS_KEYS='[{"key":"replace-with-at-least-32-random-ascii-characters","actor_id":"local-user-a","data_scope":"test-area-a","permissions":["module:read","artifact:read","artifact:write","dataset:read","dataset:publish","process:start","process:read","process:recover"]}]'
# Server-only key from BERVEL_ACCESS_KEYS, using 32+ letters, digits, _ or -.
# All web visitors share its data scope and permissions. No browser login.
# docker_env.py adds this setting to an existing .env without replacing secrets.
BERVEL_WEB_ACCESS_KEY=replace-with-the-same-key-as-the-selected-api-binding
# Optional localhost ports (defaults shown):
# BERVEL_HTTP_PORT=5173
# BERVEL_API_PORT=8011
# BERVEL_POSTGRES_PORT=5433

# Shared knowledge index. Generation provider is configured separately.
# OpenAI key remains server-side. This template contains no valid credentials.
BERVEL_EMBEDDING_PROVIDER=openai
BERVEL_EMBEDDING_API_KEY=
# Alternative: BERVEL_EMBEDDING_PROVIDER=local uses pinned multilingual-e5-small
# on CPU, downloads its weights once, and requires no OpenAI key.
# Switching provider requires explicit reindexing; existing vectors are not mixed.

# Kontur.Zakupki: backend-only key for the API and radar worker.
KONTUR_API_KEY=
# AI radar only. Use http://kontur-simulator:8765 with the simulator Compose overlay.
BERVEL_AI_RADAR_KONTUR_BASE_URL=https://api-zakupki.kontur.ru

# Private inspection executor uses this host path only for allowlisted test mounts.
# .dev/scripts/docker_env.py sets the existing absolute project root automatically.
BERVEL_ENGINEERING_HOST_PROJECT_ROOT=C:/OSPanel/home/bervel.local
