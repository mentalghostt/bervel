# Copy to .env and replace every example secret, or use .dev/scripts/docker.ps1 -Action init.
# This template contains no valid credentials. Never commit .env.
COMPOSE_PROJECT_NAME=bervel
POSTGRES_PASSWORD=replace-with-generated-admin-password
BERVEL_DB_PASSWORD=replace-with-generated-app-password
BERVEL_TEST_DB_PASSWORD=replace-with-generated-test-password
N8N_DB_PASSWORD=replace-with-generated-n8n-password
N8N_ENCRYPTION_KEY=preserve-existing-key-when-restoring-n8n
REDIS_PASSWORD=replace-with-generated-redis-password
BERVEL_E2E_ACCESS_KEY=replace-with-generated-browser-test-key
BERVEL_ACCESS_KEYS='[{"key":"replace-with-at-least-32-random-ascii-characters","actor_id":"local-user-a","data_scope":"test-area-a","permissions":["module:read","artifact:read","artifact:write","dataset:read","dataset:publish"]}]'
# Optional localhost ports (defaults shown):
# BERVEL_HTTP_PORT=5173
# BERVEL_API_PORT=8011
# BERVEL_POSTGRES_PORT=5433
# Optional core 3.2 integration; leave URL empty to keep synchronous-only mode.
# Create an n8n public API key, generate separate random callback/webhook keys,
# run `python -m bervel provision-orchestration`, then save its workflow ID.
BERVEL_N8N_URL=
BERVEL_N8N_API_KEY=
BERVEL_N8N_WEBHOOK_KEY=
BERVEL_PROCESS_WORKER_KEY=
BERVEL_N8N_WORKFLOW_ID=
BERVEL_N8N_WEBHOOK_PATH=bervel-document-review-v1
BERVEL_N8N_CALLBACK_URL=http://api:8011
