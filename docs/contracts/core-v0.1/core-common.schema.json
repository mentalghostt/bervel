{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bervel:core:0.1.0:common",
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "unit", "original"],
      "properties": {
        "state": {"enum": ["KNOWN", "UNKNOWN"]},
        "value": {
          "type": ["string", "null"],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {"type": ["string", "null"], "minLength": 1},
        "original": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": {"type": ["string", "null"]},
            "unit": {"type": ["string", "null"]}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "KNOWN"}}},
          "then": {
            "properties": {
              "value": {"type": "string"},
              "unit": {"type": "string"}
            }
          },
          "else": {"properties": {"value": {"const": null}}}
        }
      ]
    }
  }
}
