{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bervel:demo.document-review:requirement-row:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "quantity"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "quantity": {"allOf": [
      {"$ref": "urn:bervel:core:0.1.0:common#/$defs/quantity"},
      {"properties": {"unit": {"enum": ["piece", null]}}}
    ]}
  }
}
