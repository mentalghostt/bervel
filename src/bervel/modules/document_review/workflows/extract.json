{
  "name": "BERVEL demo.document-review.parse v1.0.0",
  "nodes": [
    {
      "id": "start", "name": "Start", "type": "n8n-nodes-base.webhook", "typeVersion": 2,
      "position": [0, 0], "webhookId": "bervel-document-review-v1",
      "parameters": {"httpMethod": "POST", "path": "__WEBHOOK_PATH__", "authentication": "headerAuth", "responseMode": "onReceived", "options": {}},
      "credentials": {"httpHeaderAuth": {"id": "__WEBHOOK_CREDENTIAL_ID__", "name": "BERVEL process start"}}
    },
    {
      "id": "claim", "name": "Claim", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST", "url": "={{ '__CALLBACK_URL__/api/internal/v0.1/processes/' + $('Start').first().json.body.process_run_id + '/claim' }}",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({execution_id: $execution.id, invocation_token: $('Start').first().json.body.invocation_token}) }}",
        "options": {"timeout": 120000}
      },
      "credentials": {"httpHeaderAuth": {"id": "__CALLBACK_CREDENTIAL_ID__", "name": "BERVEL process callback"}}
    },
    {
      "id": "execute", "name": "Execute", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [520, 0],
      "parameters": {
        "method": "POST", "url": "={{ '__CALLBACK_URL__/api/internal/v0.1/processes/' + $('Start').first().json.body.process_run_id + '/execute' }}",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({execution_id: $execution.id, invocation_token: $('Start').first().json.body.invocation_token}) }}",
        "options": {"timeout": 120000}
      },
      "credentials": {"httpHeaderAuth": {"id": "__CALLBACK_CREDENTIAL_ID__", "name": "BERVEL process callback"}}
    }
  ],
  "connections": {
    "Start": {"main": [[{"node": "Claim", "type": "main", "index": 0}]]},
    "Claim": {"main": [[{"node": "Execute", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1", "saveExecutionProgress": true, "saveDataErrorExecution": "all", "saveDataSuccessExecution": "all"}
}
